{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "main": "dist/index.js",
  "private": true,
  "dependencies": {
    "axios": "^0.33.0",
    "cheerio": "^1.2.0",
    "common": "file:local_modules/common",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "geoip-lite": "^1.2.1",
    "googleapis": "^173.0.0",
    "he": "^1.1.1",
    "is_js": "^0.9.0",
    "isbn": "^0.4.0",
    "lodash": "^4.17.4",
    "moji": "git+https://github.com/niwaringo/moji.git",
    "unfluff": "^1.1.0",
    "xml2js": "^0.5.0",
    "youtube-api": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.0.37",
    "@types/jest": "^30.0.0",
    "@types/node": "^8.0.47",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^2.5.3"
  },
  "jest": {
    "coverageDirectory": "coverage",
    "setupFiles": [
      "<rootDir>/src/set-up-tests.ts"
    ],
    "transform": {
      "^.+\\.ts$": "<rootDir>/node_modules/ts-jest/preprocessor.js"
    },
    "transformIgnorePatterns": [],
    "testEnvironment": "node",
    "testRegex": "/__tests__/.+\\.ts$",
    "mapCoverage": true,
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "modulePathIgnorePatterns": [
      "coverage",
      "dist",
      "local_modules"
    ]
  }
}
